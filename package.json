{
  "name": "personal-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Persönliches Dashboard – React + Vite Frontend mit Express Backend, containerisiert für 24/7-Betrieb.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "node server/index.js"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "concurrently": "^9.1.0"
  }
}
