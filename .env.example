# ===========================================================================
# Zugangsdaten für die Dienste-Anbindung.
# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# WICHTIG: Die .env NIEMALS committen (sie ist in .gitignore). Secrets bleiben
# nur auf dem Server. Rechte einschränken:  chmod 600 .env
# ===========================================================================

# --- iCloud Kalender (CalDAV, read-only) -----------------------------------
# App-spezifisches Passwort erstellen: appleid.apple.com → Anmeldung &
# Sicherheit → App-spezifische Passwörter.
ICLOUD_CALDAV_USERNAME=
ICLOUD_CALDAV_APP_PASSWORD=
# Optional: nur einen bestimmten Kalender laden (Teil des Namens). Leer = alle.
ICLOUD_CALENDAR_NAME=

# --- iCloud Mail (IMAP, read-only) -----------------------------------------
# Liest nur als "wichtig" markierte (geflaggte) Mails. Eigenes app-
# spezifisches Passwort (kann dasselbe wie oben sein oder ein separates).
ICLOUD_IMAP_USERNAME=
ICLOUD_IMAP_APP_PASSWORD=

# --- Finnhub (Watchlist-Kurse) ---------------------------------------------
# Kostenlosen Key holen: finnhub.io/register -> Dashboard -> API Key.
# Free-Tier: 60 Anfragen/Minute, Echtzeitkurse nur für US-Börsen.
# Bewusst OHNE VITE_-Präfix: Der Key wird nur serverseitig benutzt. Eine
# VITE_-Variable landet im Browser-Bundle und wäre für jeden lesbar.
FINNHUB_API_KEY=

# --- News (optional) -------------------------------------------------------
# Leer lassen für die Standard-Feeds. Sonst kommagetrennte RSS-URLs.
NEWS_FEEDS=
FINANCE_FEEDS=
