# ===========================================================================
# Zugangsdaten für die Dienste-Anbindung.
# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# WICHTIG: Die .env NIEMALS committen (sie ist in .gitignore). Secrets bleiben
# nur auf dem Server. Rechte einschränken:  chmod 600 .env
# ===========================================================================

# --- iCloud Kalender (CalDAV, read-only) -----------------------------------
# App-spezifisches Passwort erstellen: appleid.apple.com → Anmeldung &
# Sicherheit → App-spezifische Passwörter.
ICLOUD_CALDAV_USERNAME=
ICLOUD_CALDAV_APP_PASSWORD=
# Optional: nur einen bestimmten Kalender laden (Teil des Namens). Leer = alle.
ICLOUD_CALENDAR_NAME=

# --- iCloud Mail (IMAP, read-only) -----------------------------------------
# Liest nur als "wichtig" markierte (geflaggte) Mails. Eigenes app-
# spezifisches Passwort (kann dasselbe wie oben sein oder ein separates).
ICLOUD_IMAP_USERNAME=
ICLOUD_IMAP_APP_PASSWORD=

# --- Finnhub (Watchlist-Kurse) ---------------------------------------------
# Kostenlosen Key holen: finnhub.io/register -> Dashboard -> API Key.
# Free-Tier: 60 Anfragen/Minute, Echtzeitkurse nur für US-Börsen.
# Bewusst OHNE VITE_-Präfix: Der Key wird nur serverseitig benutzt. Eine
# VITE_-Variable landet im Browser-Bundle und wäre für jeden lesbar.
FINNHUB_API_KEY=

# --- News (optional) -------------------------------------------------------
# Leer lassen für die Standard-Feeds. Sonst kommagetrennte RSS-URLs.
NEWS_FEEDS=
FINANCE_FEEDS=

# --- Signal-Push ------------------------------------------------------------
# Deine eigene Handynummer im internationalen Format. Der Bot koppelt sich als
# Zweitgeraet an deinen Account und schickt an "Notiz an mich".
SIGNAL_NUMBER=
# Optional: an jemand anderen schicken. Leer = an dich selbst.
SIGNAL_RECIPIENT=
# Nur aendern, wenn der Signal-Container woanders laeuft.
SIGNAL_API_URL=http://signal:8080

# --- Schulportal Hessen (Vertretungsplan) ----------------------------------
# Schul-ID finden: http://localhost:3000/api/substitutions/schools?q=<schulname>
# Benutzername ohne Schul-ID davor, also nur "Vorname.Nachname".
# ACHTUNG: Dieses Passwort oeffnet auch Noten, Nachrichten und Schulmail.
SPH_SCHOOL_ID=
SPH_USERNAME=
SPH_PASSWORD=

# Vertretungsplan-Push (unabhaengig von NOTIFY_MARKET)
NOTIFY_PLAN=on
NOTIFY_PLAN_TIME=06:45
NOTIFY_PLAN_DAYS=1,2,3,4,5
# "on" = nur schreiben, wenn wirklich Vertretungen anliegen
NOTIFY_PLAN_QUIET=off

# Staendige Ueberwachung: holt den Plan regelmaessig und meldet NUR, was sich
# gegenueber dem letzten Stand geaendert hat. Die Nachricht oben ist eine
# Momentaufnahme; Vertretungen fuer den Folgetag werden oft nachmittags oder
# abends eingetragen und waeren sonst erst am naechsten Morgen zu sehen.
NOTIFY_PLAN_WATCH=on
NOTIFY_PLAN_WATCH_INTERVAL_MIN=15
NOTIFY_PLAN_WATCH_FROM=06:00
NOTIFY_PLAN_WATCH_TO=20:00
# Standard alle Tage: der Montagsplan steht oft schon Sonntagabend.
NOTIFY_PLAN_WATCH_DAYS=0,1,2,3,4,5,6
